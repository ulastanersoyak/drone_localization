# rviz2 view of pole_tracking_sim (drone_localization), in the enu frame (east, north, up on the
# ground at AirSim's OriginGeopoint). The estimates are poses pointing along
# the estimated velocity; the true drone is the TF frame "drone".
# Opened by --rviz on the run script (rviz:=true on the launch file).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: "Grid"
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 80
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/TF
      Name: "TF (the truth)"
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 2
      Frames:
        All Enabled: false
        drone:
          Value: true
        enu:
          Value: true
    - Class: rviz_default_plugins/Pose
      Name: "fused estimate"
      Enabled: true
      Topic:
        Value: /pole/fused
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Color: 40; 255; 60
      Alpha: 0.9
      Shaft Length: 0.6
      Shaft Radius: 0.08
      Head Length: 0.3
      Head Radius: 0.2
    - Class: rviz_default_plugins/Pose
      Name: "camera ray + UWB range"
      Enabled: true
      Topic:
        Value: /pole/ray_uwb
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 140; 30
      Alpha: 0.8
      Shaft Length: 0.3
      Shaft Radius: 0.08
      Head Length: 0.3
      Head Radius: 0.2
    - Class: rviz_default_plugins/Pose
      Name: "raw GPS fix"
      Enabled: true
      Topic:
        Value: /pole/gps
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Color: 255; 220; 40
      Alpha: 0.9
      Shaft Length: 0.3
      Shaft Radius: 0.08
      Head Length: 0.3
      Head Radius: 0.2
    - Class: rviz_default_plugins/Image
      Name: "pole camera (YOLO's boxes)"
      Enabled: true
      Topic:
        Value: /pole/dbg_image
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Normalize Range: true
  Enabled: true
  Global Options:
    Fixed Frame: enu
    Background Color: 40; 40; 44
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: "Current View"
      Target Frame: <Fixed Frame>
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 6
      Pitch: 0.6
      Yaw: -1.2
